    {
      "parameters": {
        "jsCode": "// Get all incoming items\nconst items = $input.all();\n\nconst MAX_UNRESTRICTED = 2000;\nconst MIN_UNRESTRICTED = 0.99;\nconst SAMPLE_SIZE = 5;\n\n// ========================================\n// 1. Filter valid rows\n// ========================================\nconst filtered = items.filter(item => {\n  const unrestricted = Number(item.json.Unrestricted);\n\n  return !isNaN(unrestricted) &&\n         unrestricted >= MIN_UNRESTRICTED &&\n         unrestricted <= MAX_UNRESTRICTED;\n});\n\n// ========================================\n// 2. Remove duplicate Materials\n// ========================================\nconst unique = [];\nconst seenMaterials = new Set();\n\nfor (const item of filtered) {\n  const material = String(item.json.Material || '').trim();\n\n  // Skip rows without Material\n  if (!material) continue;\n\n  // Skip duplicate Material\n  if (seenMaterials.has(material)) continue;\n\n  seenMaterials.add(material);\n  unique.push(item);\n}\n\n// ========================================\n// 3. Group by Category\n// ========================================\nconst grouped = {};\n\nfor (const item of unique) {\n  const category = item.json.Category || 'Unknown';\n\n  if (!grouped[category]) {\n    grouped[category] = [];\n  }\n\n  grouped[category].push(item);\n}\n\n// ========================================\n// 4. Randomly select up to 5 per Category\n// ========================================\nconst selected = [];\n\nfor (const [category, rows] of Object.entries(grouped)) {\n\n  // Fisher-Yates shuffle\n  const shuffled = [...rows];\n\n  for (let i = shuffled.length - 1; i > 0; i--) {\n    const j = Math.floor(Math.random() * (i + 1));\n    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];\n  }\n\n  // Select up to 5 unique Materials\n  const selectedRows = shuffled.slice(0, SAMPLE_SIZE);\n\n  selected.push(...selectedRows);\n}\n\n// ========================================\n// 5. Return selected rows\n// ========================================\nreturn selected;"
      },
